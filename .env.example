# ---- Домен и HTTPS (используются docker-compose и Caddy) ----
# Ваш домен, направленный A-записью на IP сервера. Без домена: DOMAIN=:80
DOMAIN=vtt.example.ru
# Полный адрес сайта (по нему проверяется источник подключений к игре)
PUBLIC_URL=https://vtt.example.ru

# ---- Регистрация ----
# true — любой может создать аккаунт; false — только через администратора (node server/cli.js create-user)
ALLOW_REGISTRATION=true
# Если задан — при регистрации нужно ввести этот код (удобно, чтобы пускать только своих)
REGISTRATION_CODE=
# Логин, который автоматически станет администратором (первый зарегистрированный — тоже)
ADMIN_USERNAME=
# Сколько аккаунтов можно создать с одного IP за 10 минут (защита от спама)
REGISTER_RATE_LIMIT=10

# ---- Файлы ----
# Максимальный размер картинки/видео и аудио (МБ); место на пользователя (МБ, 0 — без ограничения)
MAX_UPLOAD_MB=200
MAX_AUDIO_MB=200
USER_QUOTA_MB=0

# ---- Голосовой и видеочат ----
# Голос и видео идут напрямую между игроками (WebRTC); нужен HTTPS (с доменом он есть).
VOICE_ENABLED=true
# Сколько человек одновременно в голосовом чате одного стола
VOICE_MAX=10
# STUN-серверы через запятую — помогают соединиться игрокам за домашними роутерами
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# Свой TURN-сервер — если у кого-то голос не соединяется (мобильный интернет, офисные сети).
# Раскомментируйте, впишите домен и длинный случайный секрет, затем: docker compose --profile voice up -d
# TURN_URLS=turn:vtt.example.ru:3478?transport=udp,turn:vtt.example.ru:3478?transport=tcp
# TURN_SECRET=замените-на-длинную-случайную-строку

# ---- Резервные копии ----
# Копия базы раз в N часов (0 — выключить) и сколько копий хранить; лежат в DATA_DIR/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# ---- Прочее ----
# Срок жизни входа (дней)
SESSION_DAYS=60
# Сколько последних сообщений чата отдавать при входе
CHAT_HISTORY=200
# Импорт листов с GitHub: gm — любой мастер, admin — только администратор
SHEET_IMPORT=gm
# Токен GitHub (необязательно) — снимает лимит 60 запросов/час при импорте листов
GITHUB_TOKEN=
# Репозиторий и ветка листов Roll20
SHEETS_REPO=Roll20/roll20-character-sheets
SHEETS_BRANCH=master

# Для запуска без Docker:
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data
# Если сайт работает за обратным прокси (nginx/Caddy), оставьте 1; без прокси — false
# TRUST_PROXY=1
# Принудительно ставить cookie с флагом Secure (по умолчанию — автоматически по HTTPS)
# COOKIE_SECURE=
